# Copy to .env. The Jev key is only needed for the jev backend; the lexicon backend works offline.
TYPESAFE_API_KEY=paste-your-key-from-https://console.typesafe.ai/keys

# Server (packages/server). Leave TONEDOWN_API_KEYS empty for open local development.
TONEDOWN_BACKEND=jev            # jev | lexicon | qwen3guard
TONEDOWN_API_KEYS=              # "key1:tenant-a,key2:tenant-b"; empty = open access
TONEDOWN_DEFAULT_POLICY=balanced
TONEDOWN_CACHE_PATH=            # empty = in-memory LRU; a path = sqlite file
TONEDOWN_RATE_LIMIT=600         # requests per minute per tenant
TONEDOWN_CORS_ORIGINS=*
TONEDOWN_FEEDBACK_PATH=feedback.jsonl
TONEDOWN_PORT=8080
